# PostgreSQL : créer la base avant d'exécuter Alembic.
DATABASE_URL=postgresql+psycopg://pme_user:change_me@localhost:5432/pme_manager
# Générer une valeur longue, aléatoire et propre à chaque environnement.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
